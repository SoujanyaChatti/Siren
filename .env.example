# Copy to .env and fill in. Never commit .env. All AI calls go through the backend; keys never reach the browser.
DEMO_OFFLINE=true                 # true = AI and voice read only from cache/; replay areas run fully offline
ALLOW_LIVE_DATA=true              # /live status: free NOAA/USGS/NWS feeds (needs internet)

GEMINI_API_KEY=                   # Google AI Studio (free tier, Flash models)
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=                     # Groq free tier: text fallback + Whisper speech-to-text fallback
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ELEVENLABS_API_KEY=               # ElevenLabs free plan (~10 min/month): cache every clip
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_CHAR_BUDGET=8000         # safety cap per server run (free plan ~10k chars/month)
# Free plans can only use ElevenLabs default voices via the API (Sarah below); library voices need a paid plan
ELEVENLABS_VOICE_EN=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ES=EXAVITQu4vr4xnSDxMaL

DATABASE_URL=                     # e.g. postgres://postgres:siren@localhost:5432/siren (TimescaleDB / Tiger Data)
CORS_ORIGINS=*
SIREN_USER_AGENT=SIREN-hackathon/0.1 (flood alert demo; your-email@example.com)
AUDIENCE_QUESTION_LIMIT=3

# Frontend (build time)
VITE_API_BASE=                    # empty when the backend serves the frontend (single deploy)
VITE_PUBLIC_URL=                  # public URL encoded in the QR code; defaults to the page origin
